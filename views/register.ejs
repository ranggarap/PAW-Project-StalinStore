<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>body { font-family: 'Roboto', sans-serif; }</style>
</head>
<body class="bg-[#f7f8f9] text-[#002f34] min-h-screen flex flex-col justify-between">

    <!-- Simple Top Bar -->
    <header class="bg-white border-b border-gray-200 py-3.5 px-6">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <a href="/" class="flex items-center gap-1.5">
                <span class="text-3xl font-black tracking-tighter text-[#002f34]">OLX</span>
                <span class="text-xs font-bold uppercase tracking-widest px-1.5 py-0.5 rounded bg-teal-100 text-[#002f34]">Stalin</span>
            </a>
            <a href="/" class="text-xs font-bold text-gray-500 hover:text-[#002f34]">&larr; Kembali ke Beranda</a>
        </div>
    </header>

    <!-- Register Box -->
    <main class="flex-grow flex items-center justify-center p-4">
        <div class="bg-white border border-gray-200 rounded-lg p-6 sm:p-8 max-w-md w-full shadow-md my-4">
            
            <div class="text-center mb-6">
                <span class="text-4xl block mb-2">📝</span>
                <h1 class="text-xl font-black text-[#002f34]">Daftar Akun Stalin Store</h1>
                <p class="text-xs text-gray-500 mt-1">Mulai jual dan beli hardware komputer berkualitas</p>
            </div>

            <!-- Pesan Error -->
            <% if (error) { %>
                <div class="mb-4 p-3 rounded bg-rose-50 border border-rose-200 text-rose-700 text-xs">
                    <%= error %>
                </div>
            <% } %>

            <!-- Form Register -->
            <form action="/register" method="POST" class="space-y-3.5">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nama Lengkap *</label>
                    <input 
                        type="text" 
                        name="nama" 
                        required 
                        placeholder="Contoh: Budi Santoso" 
                        class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition"
                    >
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Alamat Email *</label>
                    <input 
                        type="email" 
                        name="email" 
                        required 
                        placeholder="nama@email.com" 
                        class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition"
                    >
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Password *</label>
                    <input 
                        type="password" 
                        name="password" 
                        required 
                        placeholder="Minimal 6 karakter" 
                        class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition"
                    >
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nomor WhatsApp / HP</label>
                    <input 
                        type="text" 
                        name="no_hp" 
                        placeholder="0812-xxxx-xxxx" 
                        class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition"
                    >
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Kota / Lokasi Domisili</label>
                    <select name="lokasi" class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition">
                        <% locations.filter(l => l !== 'Semua Lokasi').forEach(loc => { %>
                            <option value="<%= loc %>"><%= loc %></option>
                        <% }) %>
                    </select>
                </div>

                <button type="submit" class="w-full bg-[#002f34] hover:bg-teal-900 text-white font-bold py-2.5 rounded text-sm transition shadow mt-2">
                    Daftar Sekarang
                </button>
            </form>

            <div class="mt-6 pt-4 border-t border-gray-100 text-center text-xs text-gray-600">
                Sudah memiliki akun? 
                <a href="/login" class="font-bold text-teal-700 hover:underline">
                    Masuk di sini
                </a>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-[#ebedf0] py-4 text-center text-xs text-gray-500">
        &copy; <%= new Date().getFullYear() %> Stalin Store &bull; Praktikum Pemrograman Aplikasi Web
    </footer>

</body>
</html>
