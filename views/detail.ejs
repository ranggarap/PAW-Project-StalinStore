<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>body { font-family: 'Roboto', sans-serif; }</style>
</head>
<body class="bg-[#f7f8f9] text-[#002f34] min-h-screen flex flex-col justify-between">

    <!-- Top Navbar -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
            <a href="/" class="flex items-center gap-1.5 group">
                <span class="text-3xl font-black tracking-tighter text-[#002f34]">Stalin</span>
                <span class="text-xs font-bold uppercase tracking-widest px-1.5 py-0.5 rounded bg-teal-100 text-[#002f34]">Stalin</span>
            </a>
            <div class="flex items-center space-x-4">
                <a href="/" class="text-sm font-medium text-gray-600 hover:text-[#002f34]">&larr; Kembali ke Katalog</a>
                <% if (user) { %>
                    <a href="/profile" class="text-xs font-bold text-[#002f34] bg-gray-100 px-3 py-1.5 rounded hover:bg-gray-200">
                        Profil (<%= user.nama.split(' ')[0] %>)
                    </a>
                <% } else { %>
                    <a href="/login" class="text-xs font-bold text-[#002f34] hover:underline">Login / Daftar</a>
                <% } %>
                <a href="/jual" class="bg-[#002f34] text-white text-xs font-bold px-4 py-2 rounded-full hover:bg-teal-900 transition">
                    + JUAL
                </a>
            </div>
        </div>
    </header>

    <!-- Main Detail Section -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 w-full flex-grow">
        
        <!-- Breadcrumbs -->
        <nav class="text-xs text-gray-500 mb-6 flex items-center space-x-2">
            <a href="/" class="hover:underline">Beranda</a>
            <span>/</span>
            <a href="/?kategori=<%= encodeURIComponent(produk.kategori) %>" class="hover:underline"><%= produk.kategori %></a>
            <span>/</span>
            <span class="text-gray-800 font-semibold truncate"><%= produk.nama %></span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Kolom Kiri: Gambar & Deskripsi (2 Kolom) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Gambar Utama -->
                <div class="bg-white border border-gray-200 rounded-lg overflow-hidden relative shadow-sm">
                    <img src="<%= produk.gambar %>" alt="<%= produk.nama %>" class="w-full h-80 sm:h-96 object-cover bg-gray-100">
                    
                    <% if (!produk.stok) { %>
                        <div class="absolute inset-0 bg-black/60 flex items-center justify-center backdrop-blur-[2px]">
                            <span class="bg-red-600 text-white font-black text-lg px-6 py-2 rounded shadow-2xl border-2 border-white tracking-widest uppercase transform -rotate-6">
                                BARANG TERJUAL
                            </span>
                        </div>
                    <% } %>
                </div>

                <!-- Deskripsi Produk -->
                <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
                    <h3 class="text-base font-bold text-[#002f34] border-b pb-3 mb-4">
                        Deskripsi Iklan
                    </h3>
                    <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-line">
                        <%= produk.deskripsi %>
                    </p>

                    <div class="mt-8 pt-4 border-t border-gray-100 grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs">
                        <div>
                            <span class="text-gray-400 block mb-1">Kategori</span>
                            <span class="font-bold text-gray-800"><%= produk.kategori %></span>
                        </div>
                        <div>
                            <span class="text-gray-400 block mb-1">Kondisi</span>
                            <span class="font-bold text-gray-800"><%= produk.kondisi %></span>
                        </div>
                        <div>
                            <span class="text-gray-400 block mb-1">Status Ketersediaan</span>
                            <span class="font-bold <%= produk.stok ? 'text-emerald-600' : 'text-red-600' %>">
                                <%= produk.stok ? 'Tersedia' : 'Sudah Terjual' %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kolom Kanan: Harga, Penjual & Aksi (1 Kolom) -->
            <div class="space-y-6">
                <!-- Card Harga & Judul -->
                <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
                    <p class="text-2xl sm:text-3xl font-black text-[#002f34]">
                        <%= formatRupiah(produk.harga) %>
                    </p>
                    <h1 class="text-base font-bold text-gray-800 mt-2 leading-snug">
                        <%= produk.nama %>
                    </h1>

                    <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
                        <span>📍 <%= produk.lokasi %></span>
                        <span>🕒 <%= produk.waktu_post %></span>
                    </div>

                    <!-- Tombol Aksi Penjual (Jika Pemilik) -->
                    <% if (isOwner) { %>
                        <div class="mt-5 pt-4 border-t border-gray-100 bg-teal-50 p-3 rounded">
                            <span class="text-xs font-bold text-teal-800 block mb-2">⭐ Anda adalah pemilik iklan ini</span>
                            <form action="/produk/<%= produk.id %>/toggle-stok" method="POST">
                                <button type="submit" class="w-full text-xs font-bold py-2 rounded transition <%= produk.stok ? 'bg-amber-600 hover:bg-amber-700 text-white' : 'bg-emerald-600 hover:bg-emerald-700 text-white' %>">
                                    <%= produk.stok ? 'Tandai Sebagai "TERJUAL"' : 'Tandai Sebagai "TERSEDIA LAGI"' %>
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>

                <!-- Card Penjual (Seller Box) -->
                <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-4">Informasi Penjual</h3>
                    <div class="flex items-center space-x-3 mb-5">
                        <div class="w-12 h-12 rounded-full bg-teal-700 text-white font-bold flex items-center justify-center text-lg">
                            <%= produk.penjual ? produk.penjual.nama.charAt(0) : 'P' %>
                        </div>
                        <div>
                            <h4 class="text-sm font-bold text-gray-800"><%= produk.penjual ? produk.penjual.nama : 'Penjual Terverifikasi' %></h4>
                            <p class="text-xs text-gray-500"><%= produk.penjual ? produk.penjual.lokasi : produk.lokasi %></p>
                        </div>
                    </div>

                    <% if (produk.penjual && produk.penjual.no_hp) { %>
                        <a href="https://wa.me/<%= produk.penjual.no_hp.replace(/[^0-9]/g, '') %>?text=Halo%20saya%20tertarik%20dengan%20iklan%20<%= encodeURIComponent(produk.nama) %>" 
                           target="_blank" 
                           class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded text-xs flex items-center justify-center gap-2 transition shadow">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                            </svg>
                            Hubungi Penjual (<%= produk.penjual.no_hp %>)
                        </a>
                    <% } %>

                    <div class="mt-4 p-3 bg-gray-50 rounded text-[11px] text-gray-500">
                        💡 <strong>Tips Aman Berbelanja:</strong> Bertemulah langsung (COD) di tempat umum yang aman untuk memeriksa fisik hardware sebelum melakukan pembayaran.
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-[#002f34] text-white py-4 px-6 text-center text-xs">
        &copy; <%= new Date().getFullYear() %> Stalin Store &bull; Praktikum Pemrograman Aplikasi Web (PPAW Week 7).
    </footer>

</body>
</html>
