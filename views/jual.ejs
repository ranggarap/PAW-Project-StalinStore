<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>body { font-family: 'Roboto', sans-serif; }</style>
</head>
<body class="bg-[#f7f8f9] text-[#002f34] min-h-screen flex flex-col justify-between">

    <!-- Top Navbar -->
    <header class="bg-white border-b border-gray-200 py-3.5 px-6">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <a href="/" class="flex items-center gap-1.5">
                <span class="text-3xl font-black tracking-tighter text-[#002f34]">OLX</span>
                <span class="text-xs font-bold uppercase tracking-widest px-1.5 py-0.5 rounded bg-teal-100 text-[#002f34]">Stalin</span>
            </a>
            <a href="/" class="text-xs font-bold text-gray-500 hover:text-[#002f34]">&larr; Batal & Kembali ke Beranda</a>
        </div>
    </header>

    <!-- Main Form Section -->
    <main class="max-w-3xl mx-auto px-4 py-8 w-full flex-grow">
        
        <div class="bg-white border border-gray-200 rounded-lg p-6 sm:p-8 shadow-sm">
            
            <div class="border-b border-gray-200 pb-4 mb-6">
                <span class="text-xs font-black uppercase tracking-wider text-teal-700 bg-teal-50 px-2 py-0.5 rounded">
                    + PASANG IKLAN BARU
                </span>
                <h1 class="text-2xl font-black text-[#002f34] mt-2">
                    Jual Hardware Komputer Anda
                </h1>
                <p class="text-xs text-gray-500 mt-1">
                    Isi rincian hardware komputer, laptop, atau komponen PC yang ingin Anda jual di Stalin Store.
                </p>
            </div>

            <!-- Error Banner -->
            <% if (error) { %>
                <div class="mb-5 p-3 rounded bg-rose-50 border border-rose-200 text-rose-700 text-xs">
                    <%= error %>
                </div>
            <% } %>

            <!-- Form Jual -->
            <form action="/jual" method="POST" class="space-y-5">
                
                <!-- Judul Iklan -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Judul Iklan Hardware *
                    </label>
                    <input 
                        type="text" 
                        name="nama" 
                        required 
                        placeholder="Contoh: Laptop ASUS ROG Zephyrus G14 Ryzen 9 RTX 3060" 
                        class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition"
                    >
                    <span class="text-[11px] text-gray-400 mt-0.5 block">Sebutkan merk, tipe, dan spesifikasi kunci produk.</span>
                </div>

                <!-- Kategori & Kondisi (Grid 2 Kolom) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">
                            Kategori Hardware *
                        </label>
                        <select name="kategori" class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition">
                            <% categories.filter(c => c !== 'Semua Kategori').forEach(kat => { %>
                                <option value="<%= kat %>"><%= kat %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">
                            Kondisi Barang *
                        </label>
                        <div class="flex items-center space-x-6 mt-2">
                            <label class="flex items-center space-x-2 text-sm cursor-pointer">
                                <input type="radio" name="kondisi" value="Bekas" checked class="text-teal-600 focus:ring-teal-500">
                                <span class="font-medium text-gray-800">Bekas (Second)</span>
                            </label>
                            <label class="flex items-center space-x-2 text-sm cursor-pointer">
                                <input type="radio" name="kondisi" value="Baru" class="text-teal-600 focus:ring-teal-500">
                                <span class="font-medium text-gray-800">Baru (BNIB)</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Harga & Lokasi (Grid 2 Kolom) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">
                            Harga Jual (Rp) *
                        </label>
                        <input 
                            type="number" 
                            name="harga" 
                            required 
                            min="1000"
                            placeholder="Contoh: 12500000" 
                            class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition font-mono"
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">
                            Lokasi COD / Toko *
                        </label>
                        <select name="lokasi" class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition">
                            <% locations.filter(l => l !== 'Semua Lokasi').forEach(loc => { %>
                                <option value="<%= loc %>" <%= (user && user.lokasi === loc) ? 'selected' : '' %>><%= loc %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <!-- URL Foto Produk -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        URL Foto Produk (Gambar)
                    </label>
                    <input 
                        type="url" 
                        name="gambar" 
                        id="gambar-input"
                        placeholder="https://images.unsplash.com/..." 
                        class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition"
                    >
                    
                    <!-- Pilihan Cepat Foto Sample -->
                    <div class="mt-2 text-[11px] text-gray-500 flex flex-wrap items-center gap-1.5">
                        <span class="font-bold">Pilihan cepat contoh foto:</span>
                        <button type="button" onclick="setSampleImg('https://images.unsplash.com/photo-1593642632823-8f785ba67e45?auto=format&fit=crop&w=600&q=80')" class="underline hover:text-teal-700">Laptop</button>
                        <span>&bull;</span>
                        <button type="button" onclick="setSampleImg('https://images.unsplash.com/photo-1591488320449-011701bb6704?auto=format&fit=crop&w=600&q=80')" class="underline hover:text-teal-700">VGA RTX</button>
                        <span>&bull;</span>
                        <button type="button" onclick="setSampleImg('https://images.unsplash.com/photo-1587831990711-23ca6441447b?auto=format&fit=crop&w=600&q=80')" class="underline hover:text-teal-700">PC Gaming</button>
                    </div>
                </div>

                <!-- Deskripsi Lengkap -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Deskripsi Lengkap
                    </label>
                    <textarea 
                        name="deskripsi" 
                        rows="4" 
                        placeholder="Jelaskan kondisi fisik, kelengkapan (dus, charger, garansi), alasan jual, dan minus jika ada..." 
                        class="w-full px-3 py-2 text-sm border-2 border-gray-300 rounded focus:border-[#002f34] focus:outline-none transition"
                    ></textarea>
                </div>

                <!-- Tombol Submit -->
                <div class="pt-4 border-t border-gray-200 flex items-center justify-end space-x-3">
                    <a href="/" class="px-5 py-2.5 rounded text-xs font-bold text-gray-600 hover:bg-gray-100 transition">
                        Batal
                    </a>
                    <button type="submit" class="bg-[#002f34] hover:bg-teal-900 text-white font-bold px-6 py-2.5 rounded text-sm transition shadow-md">
                        Terbitkan Iklan Sekarang
                    </button>
                </div>

            </form>

        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-[#ebedf0] py-4 text-center text-xs text-gray-500">
        &copy; <%= new Date().getFullYear() %> Stalin Store &bull; Praktikum Pemrograman Aplikasi Web
    </footer>

    <script>
        function setSampleImg(url) {
            document.getElementById('gambar-input').value = url;
        }
    </script>

</body>
</html>
